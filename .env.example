# Copy to .env and fill in. Never commit real values.
# The connector is single-user: it talks to exactly one Home Assistant
# instance, configured here. Requests carry no credentials.
HA_URL=http://192.168.1.50:8123
HA_TOKEN=your-long-lived-access-token
HA_VERIFY_SSL=true

# Transport (stdio for local use, http for deployment)
HA_MCP_TRANSPORT=http
HA_MCP_PORT=8000

# Read-only mode (default true: actuation tools refuse to run).
# Set to false to allow service calls and automation triggers.
HA_MCP_READ_ONLY=true

# Host header values permitted behind a tunnel/proxy
HA_MCP_ALLOWED_HOSTS=ha-mcp.yourdomain.com
