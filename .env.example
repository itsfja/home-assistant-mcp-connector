# Copy to .env and fill in for local single-user use. Never commit real values.
# Credentials are required per request: X-Home-Assistant-Connection: <url>|<token>
# or X-Home-Assistant-Url + X-Home-Assistant-Token headers.
# Env-var credential fallback has been removed (multi-tenant by design).
HA_VERIFY_SSL=true

# Transport (stdio for local use, http for deployment)
HA_MCP_TRANSPORT=http
HA_MCP_PORT=8000

# Read-only mode (default true: actuation tools refuse to run).
# Set to false to allow service calls and automation triggers.
HA_MCP_READ_ONLY=true

# Host header values permitted by the HTTP transport behind a tunnel/proxy
HA_MCP_ALLOWED_HOSTS=ha-mcp.yourdomain.com
